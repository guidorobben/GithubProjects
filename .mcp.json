{
  "mcpServers": {
    "bc-knowledge": {
      "command": "npx",
      "args": [
        "--prefer-offline",
        "bc-code-intelligence-mcp"
      ]
    },
    "al": {
      "command": "al",
      "args": [
        "launchmcpserver",
        "--transport",
        "stdio"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
